# Copy to .env.local and fill in. .env* files are gitignored.

# Where the Go API runs (no trailing slash).
GO_API_URL=http://localhost:8080

# Same value as INTERNAL_SERVICE_SECRET in the backend. Server only.
INTERNAL_SERVICE_SECRET=

# Ed25519 private key (PKCS8 PEM) that signs API tokens. Server only. The backend holds the public half.
# Make a pair with, in the backend repo: go run ./cmd/devtoken keygen dev-key.private.pem
# In .env.local write the PEM on one line with \n between lines.
API_TOKEN_PRIVATE_KEY=
API_TOKEN_ISSUER=signoffly-web

# Auth.js
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Local development only: shows a "Dev sign in" form so you can use the app without a GitHub OAuth app.
# Ignored when NODE_ENV is production.
ALLOW_DEV_LOGIN=