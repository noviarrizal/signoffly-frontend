# Copy to .env.local and fill in. .env* files are gitignored.

# The public address of this site, used for search engines and link previews (sitemap, robots.txt, og:image).
# Production example: https://signoffly.duckdns.org. Read when the server runs, so changing it needs a restart, not a rebuild.
SITE_URL=http://localhost:3000

# The header our own reverse proxy (Caddy, see the backend repo: deploy/Caddyfile) sets to the real address of the visitor.
# It is passed on to the API so that its limits apply to each visitor and not to this server. Behind Cloudflare set it to
# cf-connecting-ip. Leave it alone when running locally without a proxy: there is then no address to pass on.
# The backend must read the name we send: CLIENT_IP_HEADER=X-Client-IP there.
CLIENT_IP_HEADER=x-real-ip

# Where the Go API runs (no trailing slash).
GO_API_URL=http://localhost:8080

# Same value as INTERNAL_SERVICE_SECRET in the backend. Server only.
INTERNAL_SERVICE_SECRET=

# Ed25519 private key (PKCS8 PEM) that signs API tokens. Server only. The backend holds the public half.
# Make a pair with, in the backend repo: go run ./cmd/devtoken keygen dev-key.private.pem
# In .env.local write the PEM on one line with \n between lines.
API_TOKEN_PRIVATE_KEY=
API_TOKEN_ISSUER=signoffly-web

# Auth.js
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Local development only: shows a "Dev sign in" form so you can use the app without a GitHub OAuth app.
# Ignored when NODE_ENV is production.
ALLOW_DEV_LOGIN=

# Who runs the service, shown in the Privacy Policy and the Terms. Use your own name or your business name.
# The pages show a visible placeholder until both are set.
LEGAL_OPERATOR_NAME=
LEGAL_CONTACT_EMAIL=
