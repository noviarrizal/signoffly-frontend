# Nothing here may reach the image: secrets, dependencies from this machine, build leftovers and test output.
# The e2e folder is NOT excluded: playwright.config.ts imports it and the build type-checks every .ts file. It is not
# copied into the final image.
.git
.gitignore
node_modules
.next
.next-*
.e2e
.env
.env.*
!.env.example
test-results
playwright-report
coverage
*.tsbuildinfo
docs
.github
